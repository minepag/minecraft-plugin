    },
    "/link": {
      "post": {
        "operationId": "minecraft.link",
        "summary": "Vincular a conta do jogador",
        "description": "Vincula o jogador ao cliente da loja pelo código que ele gerou na área do cliente. Libera as entregas que aguardavam o vínculo.",
        "security": [
          {
            "tokenDoServidor": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^[A-Z0-9]{6,12}$"
                  },
                  "playerUuid": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "playerName": {
                    "type": "string",
                    "pattern": "^(?:[A-Za-z0-9_]{3,16}|\\.[A-Za-z0-9_]{1,15})$"
                  }
                },
                "required": [
                  "code",
                  "playerUuid",
                  "playerName"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "linked": {
                      "type": "boolean",
                      "const": true
                    },
                    "message": {
                      "type": "string",
                      "maxLength": 300
                    }
                  },
                  "required": [
                    "linked",
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "`invalid_json`: O corpo da requisição não é um JSON válido. `invalid_link_code`: Código de vínculo inválido ou expirado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated`: Autenticação necessária. `server_token_revoked`: O token do servidor foi revogado. Pareie o servidor novamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "413": {
            "description": "`payload_too_large`: O corpo da requisição é grande demais.",
            "content": {
              "application/json": {
                "schema": {
