  "components": {
    "securitySchemes": {
      "tokenDoServidor": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token do servidor (`mps_…`), devolvido uma única vez por `/pair`."
      }
    },
    "schemas": {
      "Erro": {
        "type": "object",
        "properties": {
          "data": {
            "type": "null"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "unauthenticated",
                  "invalid_api_key",
                  "forbidden",
                  "insufficient_scope",
                  "not_found",
                  "invalid_json",
                  "validation_failed",
                  "payload_too_large",
                  "conflict",
                  "idempotency_conflict",
                  "rate_limited",
                  "project_restricted",
                  "checkout_paused",
                  "payment_method_unavailable",
                  "payment_declined",
                  "payment_provider_unavailable",
                  "refund_not_allowed",
                  "refund_amount_exceeded",
                  "cart_not_found",
                  "cart_empty",
                  "cart_already_checked_out",
                  "product_unavailable",
                  "out_of_stock",
                  "coupon_invalid",
                  "coupon_not_applicable",
                  "checkout_blocked",
                  "order_not_payable",
                  "invalid_webhook_signature",
                  "delivery_already_finalized",
                  "invalid_pairing_code",
                  "pairing_code_expired",
                  "server_token_revoked",
                  "server_paused",
                  "invalid_link_code",
                  "invalid_player_name",
                  "plugin_outdated",
                  "internal_error",
                  "service_unavailable"
                ]
              },
              "message": {
                "type": "string"
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "message"
                  ],
                  "additionalProperties": false
                }
              },
              "details": {
                "description": "Dados para seguir o fluxo. Em `payment_declined`, o mesmo objeto da resposta de sucesso do checkout: pedido, pagamento recusado, `accessToken` e `orderUrl`. Em `payment_provider_unavailable` no checkout e na nova tentativa de pagamento, o pedido já criado, o pagamento pendente (sem cobrança), o `accessToken` e o `orderUrl`.",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "data",
          "errors",
          "error",
          "meta"
        ],
        "additionalProperties": false
      }
    }
  },
