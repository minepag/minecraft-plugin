  "x-minepag-limits": {
    "defaultPollSeconds": 30,
    "minPollSeconds": 5,
    "maxPollSeconds": 300,
    "commandLeaseSeconds": 120,
    "pairingCodeTtlMinutes": 10,
    "linkCodeTtlMinutes": 10,
    "maxOnlinePlayers": 2000,
    "maxCommandsPerPull": 100,
    "maxAckBatch": 100,
    "heartbeatIntervalSeconds": 300
  }
